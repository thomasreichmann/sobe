{
  "openapi": "3.0.1",
  "info": {
    "title": "Sobe API",
    "description": "Situação dos elevadores, escadas rolantes e plataformas das estações, com alertas gerados por sensores.",
    "version": "v1"
  },
  "paths": {
    "/api/alertas": {
      "get": {
        "tags": [
          "Alertas"
        ],
        "summary": "Paradas detectadas, das mais recentes para as mais antigas",
        "description": "Por padrão traz só as paradas em aberto. Com somenteFavoritas, só as das estações que o usuário acompanha.",
        "parameters": [
          {
            "name": "somenteAbertos",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": true
            }
          },
          {
            "name": "somenteFavoritas",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AlertaResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
