    "/api/leituras": {
      "post": {
        "tags": [
          "Sensores"
        ],
        "summary": "Recebe a leitura de um sensor (chave de dispositivo)",
        "description": "Acima do limite, o equipamento passa a PARADO e um alerta é aberto. Quando todos os sensores do equipamento voltam ao normal, o alerta é encerrado.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LeituraRequest"
              }
            },
            "text/json": {
